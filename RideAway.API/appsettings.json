{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GoogleMaps": {
    "ApiKey": ""
  },
  "Stripe": {
    "SecretKey": "",
    "Currency": "ZAR",
    "WebhookSecret": "",
    "SuccessUrl": "https://app.rideaway.co.za/payment/success",
    "CancelUrl": "https://app.rideaway.co.za/payment/cancel"
  },
  "Jwt": {
    "Issuer": "RideAway",
    "Audience": "RideAway"
  },
  "SendGrid": {
    "ApiKey": ""
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../logs/rideaway_.log",
          "rollOnFileSizeLimit": "true",
          "fileSizeLimitBytes": 10000000,
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3}] {Username} ({SourceContext}) {Message:lj} {NewLine} {Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost; Database=RideAway; Trusted_Connection=True; TrustServerCertificate=True;"
  },
  "RateLimiting": {
    "Strict": {
      "Enabled": true,
      "PermitLimit": 10,
      "WindowSeconds": 300
    },
    "Global": {
      "Enabled": true,
      "PermitLimit": 600,
      "WindowSeconds": 60
    }
  }
}
